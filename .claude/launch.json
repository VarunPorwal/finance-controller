{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "api.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "web-app2",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web-app2",
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": false
    }
  ]
}
