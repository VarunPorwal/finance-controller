# Base URL of the FastAPI app (see ../.env's API_BASE_URL).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Must match the backend's DEMO_TOKEN (../.env). PRD §9.1: single-tenant
# buildathon demo, baked into the client bundle at build time — never stored
# in localStorage/sessionStorage, never typed in by a user.
NEXT_PUBLIC_DEMO_TOKEN=
